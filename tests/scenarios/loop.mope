# The loop: REC while stopped counts in a bar, then records; notes play back with the drums; SEQ opens
# the loop and its white keys are the steps (chosen, edited by the knobs, tapped away); HOME + REC undoes, SAVE + REC clears; it is saved.
wait 300
expect loopn 0
tap REC
wait 200
expect rec 1
expect drums 0
shot 00_count_in.png
# (Funeral bossa, 84 bpm: a bar is 2.9 s)
wait 2800
expect rec 2
expect drums 1
tapkey 12
wait 250
tapkey 15
wait 250
tapkey 19
wait 400
shot 01_recording.png
tap REC
expect rec 0
expect loopn 3
wait 1500
# SEQ: the loop full screen (it stays until HOME); the cursor starts on the last note played. While it is
# open the white keys are the bar's steps.
tap SEQ
wait 300
expect page 10
expect latch 1
expect curnote 72
shot 02_steps.png
# an empty step: a note comes at the cursor's note
tapkey w8
wait 100
expect loopn 4
expect curstep 8
expect lnote3 72
# the cursor's step: its key lit (w8: key 14), so you know where a tap lands
wait 100
expect leds_steps 16384
# a chord, a note at a time: knob 2 up to an empty note, the step again: another comes
turn K2 4
tapkey w8
wait 100
turn K2 3
tapkey w8
wait 100
expect loopn 6
expect lnote5 79
# knob 3: only the note under the cursor gets longer
turn K3 3
wait 100
expect llen5 20
expect llen3 11
shot 03_chord.png
# the middle note of the chord: knob 2 down onto it, the step again: only it goes
turn K2 -3
wait 100
expect curnote 76
shot 04_chord_note.png
tapkey w8
wait 100
expect loopn 5
expect lnote3 72
expect lnote4 79
shot 05_note_gone.png
# another step with notes: the cursor goes there, onto its nearest note, and nothing changes
turn K1 -8
wait 100
expect curstep 0
expect leds_steps 1
tapkey w8
wait 100
expect loopn 5
expect curstep 8
expect curnote 79
# knob 1 along the steps: past the start it wraps to the last bar's end (two bars here)
turn K1 -9
wait 100
expect curstep 31
press HOME
release HOME
wait 100
expect latch 0
# the last change undone (HOME + REC: the removed note is back), then saved and back after a restart
press HOME
tap REC
release HOME
expect loopn 6
tap PLAY
wait 600
tap SAVE
wait 200
# (SAVE AS opened: SAVE again keeps it)
tap SAVE
wait 200
reboot
wait 300
expect loopn 6
# cleared (SAVE + REC)
press SAVE
tap REC
release SAVE
expect loopn 0
expect dropped 0
