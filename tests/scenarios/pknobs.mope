# The punches' knobs: the last one punched, its two knobs, the ones a DJ rides (HALF: how low; REPEAT: the
# roll's length; GATE: its rate; SWEEP: how long...), shown as big dials with their names at the bottom corners. GRAIN comes
# in slowly. Kept over a restart.
wait 300
midi 90 30 64
midi 90 37 64
midi 90 3c 64
wait 600
# SEL twice: the punches stay, the hands free for the knobs
tap SEL
wait 100
tap SEL
wait 100
expect latch 1
# nothing punched yet: the knobs say so
spin K1 1
expect pk7_0 8
# GRAIN: slowly in
key b6 down
wait 150
expect punchbuf 7
shot 00_grain_coming_in.png
wait 900
shot 01_grain_in.png
key b6 up
wait 200
# its knobs: smaller grains, less scatter
spin K1 -4
expect pk7_0 4
spin K2 -6
expect pk7_1 9
wait 100
shot 02_grain_knobs.png
key b6 down
wait 300
shot 03_grain_tight.png
key b6 up
# HALF: another punch, its own knobs: two octaves down
key b0 down
wait 200
key b0 up
spin K1 7
expect pk0_0 15
expect pk7_0 4
wait 100
shot 04_half_knobs.png
# REPEAT: a shorter roll
key b4 down
wait 200
key b4 up
spin K1 -4
expect pk4_0 4
wait 100
shot 05_roll_knobs.png
tap SEL
wait 100
expect latch 0
midi 80 30 00
midi 80 37 00
midi 80 3c 00
wait 6000
reboot
wait 500
expect pk7_0 4
expect pk7_1 9
expect pk0_0 15
expect pk4_0 4
expect pk3_1 4
