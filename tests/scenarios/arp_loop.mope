# ARP plays what you hold, not the loop: chords recorded with ARP off stay chords when ARP comes on, and
# an arpeggio recorded with ARP on stays an arpeggio when ARP goes off.
wait 500
tap PLAY
wait 300
tap REC
wait 3500
key 0 down
key 4 down
key 7 down
wait 2500
key 0 up
key 4 up
key 7 up
wait 300
tap REC
wait 300
expect loopn 3
wait 1200
tap ARP
wait 50
expect arp 3
wait 600
expect arpseq 0
wait 2000
expect arpseq 0
# a key held now: the arpeggiator plays it
key 14 down
wait 800
expect arpseq >1
key 14 up
tap ARP
wait 300
expect arp 0
