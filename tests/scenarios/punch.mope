wait 200
key b8 down
wait 900
shot 09_sweep.png
key b8 up
wait 200
key b9 down
wait 800
shot 10_wash.png
key w12 down
wait 400
shot 10b_wash_more.png
key w12 up
key b9 up
wait 200
key b10 down
wait 500
shot 11_wobble.png
# SEL let go, the key still held: still punching
release SEL
wait 200
expect punch 2048
key b10 up
wait 600
expect punch 0
# a white key with SEL held still plays
press SEL
key w2 down
wait 200
expect voices >3
key w2 up
release SEL
# and without SEL a black key is a note again
tapkey b2
wait 100
expect punch 0
# SEL twice: the punches stay without holding it
tap SEL
wait 100
tap SEL
wait 100
expect latch 1
key b0 down
wait 200
expect punch 1
key b0 up
wait 300
tap SEL
wait 100
expect latch 0
key b0 down
wait 200
expect punch 0
key b0 up
midi 80 30 00
midi 80 37 00
midi 80 3c 00
